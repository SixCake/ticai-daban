# tushare pro token（必填，https://tushare.pro 注册获取）
# 需要 limit_list_d / daily / concept / trade_cal 等接口权限
TUSHARE_TOKEN=your_token_here

# 可选：已有的前复权日线parquet目录（每文件一只股票，列含 datetime/open/high/low/close/volume）
# 不设置则历史数据全部走 tushare pro.daily 逐日拉取
# LAB333_DAILY_DIR=/path/to/your/daily/parquet/dir

# 可选：实时行情源切换（默认tx=腾讯http；qmt=大QMT FormulaServer快路径）
# QUOTE_SOURCE=qmt
# qmt源连接参数（已固化在~/.zshrc的可不重复配置；qmt-net lan/frp 会覆盖HOST两项）
# BIGQMT_SRC_PATH=~/aiproject/xtquant_big_convert/src
# BIGQMT_ACCOUNT_ID=资金账号
# BIGQMT_REDIS_HOST=192.168.31.32
# BIGQMT_REDIS_PORT=6379
# BIGQMT_REDIS_DB=5
# BIGQMT_REDIS_PASSWORD=your_redis_password
# BIGQMT_FORMULA_HOST=192.168.31.32

# 可选：LLM 线索生产者（apps/ai_feed.py 的 llm_clue）配置
# 不配置则 llm_clue 跳过（仅规则基线 clue_rule 产出），不伪造分析
# 支持任意 OpenAI 兼容端点（OpenAI / 国产大模型 / 本地 vLLM·Ollama）
# LLM_API_KEY=your_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 可选：macOS 盘前自启（bash deploy/launchd/install.sh 安装 launchd 任务）
# 竞价量只在 09:25:00~09:29:59 可采，雷达必须在 09:25 前就绪并留足 QMT 推送预热时间
# AUTOSTART_AT=09:10
# launchd 任务名；改名可并存多份安装（例如本机有多个项目副本）
# AUTOSTART_LABEL=com.ticai-daban.morning

# 可选：竞价 tick 勘探探针（bash deploy/launchd/install.sh --job probe）
# 采 09:15~09:25 集合竞价全程的 tick 原始字段，落 data/live/auction_probe_*.jsonl
# 必须早于 09:15；采集窗口 09:25:20 结束，避开与雷达抢 QMT 订阅（共用 account_id）
# PROBE_AT=09:14
# PROBE_LABEL=com.ticai-daban.auctionprobe
